<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>x64;ARM64</Platforms>
    <IsRidAgnostic>false</IsRidAgnostic>

    <LangVersion>Preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ImageGlass</RootNamespace>

    <PublishTrimmed>true</PublishTrimmed>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <PropertyGroup>
    <MagickArchitecture>$(Platform)</MagickArchitecture>
    <MagickArchitecture Condition="$(RuntimeIdentifier.EndsWith('-x64'))">x64</MagickArchitecture>
    <MagickArchitecture Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">ARM64</MagickArchitecture>
    <MagickMacTarget Condition="$(RuntimeIdentifier.StartsWith('osx-')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('osx')))">true</MagickMacTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
    <DefineConstants>$(DefineConstants);IMAGEGLASS_MAGICK_15</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Delete.png" />
    <None Remove="Assets\Error.png" />
    <None Remove="Assets\Find.png" />
    <None Remove="Assets\icon256.ico" />
    <None Remove="Assets\Info.png" />
    <None Remove="Assets\Lock.png" />
    <None Remove="Assets\Rename.png" />
    <None Remove="Assets\Shield.png" />
    <None Remove="Assets\Warning.png" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Delete.png" />
    <AvaloniaResource Include="Assets\Error.png" />
    <AvaloniaResource Include="Assets\Find.png" />
    <AvaloniaResource Include="Assets\icon256.ico" />
    <AvaloniaResource Include="Assets\Info.png" />
    <AvaloniaResource Include="Assets\Lock.png" />
    <AvaloniaResource Include="Assets\RecycleBin.png" />
    <AvaloniaResource Include="Assets\Rename.png" />
    <AvaloniaResource Include="Assets\Shield.png" />
    <AvaloniaResource Include="Assets\Sounds\notification.wav" />
    <AvaloniaResource Include="Assets\Svg\*.svg" />
    <AvaloniaResource Include="Assets\Warning.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pro license public key (embedded so it loads before Avalonia init) -->
    <EmbeddedResource Include="Assets\Licensing\ig_license_2026.spki.pem">
      <LogicalName>ig_license_2026.spki.pem</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="D2Phap.FileWatcherEx" />
    <PackageReference Include="ImageGlass.SDK" />
    <PackageReference Include="Magick.NET-Q16-HDRI-OpenMP-x64" Condition="'$(MagickArchitecture)' == 'x64' And '$(RuntimeIdentifier)' != 'osx-x64'" />
    <PackageReference Include="Magick.NET-Q16-HDRI-OpenMP-arm64" Condition="'$(MagickArchitecture)' == 'ARM64' And '$(MagickMacTarget)' != 'true'" />
    <PackageReference Include="Magick.NET-Q16-HDRI-arm64" Condition="'$(MagickArchitecture)' == 'ARM64' And '$(MagickMacTarget)' == 'true'" />
    <PackageReference Include="NativeMemoryArray" />
    <PackageReference Include="NetCoreAudio" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Tools\Builtins\ColorPicker\ColorPickerToolControl.axaml.cs">
      <DependentUpon>ColorPickerToolControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Tools\Builtins\CropImage\CropImageToolControl.axaml.cs">
      <DependentUpon>CropImageToolControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Tools\Builtins\FrameNav\FrameNavToolControl.axaml.cs">
      <DependentUpon>FrameNavToolControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Tools\ToolHostControl.axaml.cs">
      <DependentUpon>ToolHostControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Windows\UpdateWindow.axaml.cs">
      <DependentUpon>UpdateWindow.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
    <PackageReference Include="Magick.NET-Q16-HDRI-x64" GeneratePathProperty="true" />
    <PackageReference Include="Magick.NET.Core" GeneratePathProperty="true" />
    <PackageReference Include="FarMC666.ImageGlass.Magick.Native.osx-x64" GeneratePathProperty="true" />
    <None Include="$(PkgFarMC666_ImageGlass_Magick_Native_osx-x64)/NOTICE.txt"
          Link="_credits/Magick.Native-Intel.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgFarMC666_ImageGlass_Magick_Native_osx-x64)/sources.tsv"
          Link="_credits/Magick.Native-Intel-sources.tsv" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyIntelMagickPackages" BeforeTargets="CoreCompile"
          Condition="'$(RuntimeIdentifier)' == 'osx-x64' And '$(DesignTimeBuild)' != 'true'">
    <VerifyFileHash File="$(PkgMagick_NET-Q16-HDRI-x64)/magick.net-q16-hdri-x64.15.1.0.nupkg"
                    Hash="b1ec2b0afbd4322fc716be746a480b6332d88f0ab692f9b3e35ee25d3e3f78cf" Algorithm="SHA256" />
    <VerifyFileHash File="$(PkgMagick_NET_Core)/magick.net.core.15.1.0.nupkg"
                    Hash="461232bfc8188ee3c244c7a73119a8c8d4ada46f109d7ff97952f29729bdd438" Algorithm="SHA256" />
    <VerifyFileHash File="$(PkgFarMC666_ImageGlass_Magick_Native_osx-x64)/farmc666.imageglass.magick.native.osx-x64.15.1.0-intel.1.nupkg"
                    Hash="2603e6f6a97cdb510ffe3a260020d49f0fdf996d0761cf06b800733b9c387bc9" Algorithm="SHA256" />
  </Target>

</Project>
